
    programa {
  funcao inicio() {
    real n1




    escreva("Digite sua nota: ")
    leia(n1)




    se (n1>=9 e n1<=10) {
      escreva("Excelente - nota A")
     
    } senao {
      se (n1>=7 e n1<=8.9)
    escreva("Bom - nota B")
    senao
    se( n1 >= 5 e n1 <= 6.9)
    	escreva(" Regular - nota C")
    	senao
    	se (n1>=3 e n1<=4.9)
    	escreva("Insuficiente - nota D")
    	senao
    	se (n1>=0 e n1<=2.9)
    	escreva("Reprovado - nota E")
    }

  }
    }
